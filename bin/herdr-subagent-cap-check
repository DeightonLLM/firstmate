#!/usr/bin/env bash
# herdr-subagent-cap-check — pre-spawn hook for the Herdr subagent cap.
#
# FIRSTMATE_OP v1: refuse spawn when 6 subagent panes are already open.
# Codex coordinator counts separately (max 7 total).
#
# Usage:
#   herdr-subagent-cap-check [WORKSPACE]
#
# Exit codes:
#   0   = OK to spawn
#   64  = cap reached (caller MUST abort spawn)
#   3   = herdr unavailable / cannot count
#   2   = usage error
#
# This hook is the canonical precheck. fm-spawn, the Herdr dispatch preflight
# (for new-pane creates), and any supervisor that auto-spawns MUST call it.
#
# Snapshot consolidation (v1.1, SYS-014 throughput follow-up):
#   The pre-spawn hook takes TWO `herdr pane list --workspace WS` snapshots
#   per call:
#     1. Pre-reap fixture → fed to subagent_cap_reap_stale.
#     2. Post-reap fixture → fed to subagent_cap_assert_can_spawn.
#   The previous implementation triggered THREE snapshots per call (one for
#   reap + one for subagent_cap_count_open_subagent + one for
#   subagent_cap_count_open_total). Reducing to two saves ~1/3 of the
#   spawn-check latency without weakening any safety gate:
#     - Reap is idempotent (ledger dedup by (pane_id, snapshot_hash) in
#       cap.sh), so the reaper can safely operate on a snapshot taken
#       before reap itself closes any panes.
#     - The assert snapshot is taken AFTER reap, so the cap count reflects
#       current pane state (post-reap), not pre-reap. The hook never
#       false-refuses after the reaper freed slots.
#     - All four reaper guards (live_process / transcript / brandon_hold /
#       m3_guardian) and the M3 zero-pane short-circuit are preserved
#       (delegated to cap.sh, not duplicated here).
#     - All exit codes (0 / 64 / 3 / 2) and the bypass flag are preserved.
#     - Subagent cap constants (MAX_SUBAGENT_PANES=6, MAX_TOTAL_PANES=7)
#       remain the canonical source of truth in cap.sh.

set -euo pipefail

. /root/lib/subagent-cap/cap.sh

ws="${1:-}"
ws_for_list="${1-${HERDR_WORKSPACE_ID:-}}"
ws_args=()
if [ -n "$ws_for_list" ]; then
  ws_args=(--workspace "$ws_for_list")
fi

if [ "${HERDR_SUBAGENT_CAP_BYPASS:-0}" = "1" ]; then
  printf 'SUBAGENT-CAP: bypass set (HERDR_SUBAGENT_CAP_BYPASS=1) — cap not enforced\n' >&2
  exit 0
fi

# Snapshot 1: pre-reap fixture for the reaper. Reap is idempotent (the
# ledger dedups by (pane_id, snapshot_hash)), so the reaper can safely
# operate on a snapshot taken before reap itself closes any panes.
reap_fx="$(mktemp -t herdr-cap-check-reap.XXXXXX)"
if ! timeout "${HERDR_TIMEOUT:-8}s" herdr pane list "${ws_args[@]}" >"$reap_fx" 2>/dev/null; then
  rm -f "$reap_fx"
  printf 'SUBAGENT-CAP: herdr pane list failed (server unavailable)\n' >&2
  exit 3
fi

export HERDR_FIXTURE_FILE="$reap_fx"
subagent_cap_reap_stale "$ws" >/dev/null 2>&1 || true
rm -f "$reap_fx"
unset HERDR_FIXTURE_FILE

# Snapshot 2: post-reap fixture for the cap assert. Taking this AFTER the
# reap step means the count reflects current pane state, so the hook
# never false-refuses after the reaper freed slots.
assert_fx="$(mktemp -t herdr-cap-check-assert.XXXXXX)"
if ! timeout "${HERDR_TIMEOUT:-8}s" herdr pane list "${ws_args[@]}" >"$assert_fx" 2>/dev/null; then
  rm -f "$assert_fx"
  printf 'SUBAGENT-CAP: herdr pane list failed (server unavailable)\n' >&2
  exit 3
fi

export HERDR_FIXTURE_FILE="$assert_fx"
trap 'rm -f "$assert_fx"' EXIT

if subagent_cap_assert_can_spawn "$ws"; then
  exit 0
fi

# Cap reached after reap attempt — refuse.
exit 64