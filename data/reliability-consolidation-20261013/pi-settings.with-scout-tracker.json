{
  "lastChangelogVersion": "1.1.0",
  "theme": "firstmate-black",
  "defaultProvider": "minimax",
  "defaultModel": "MiniMax-M2.7",
  "packages": [
    "npm:pi-subagents",
    "npm:@calesennett/pi-codex-fast",
    "npm:@juicesharp/rpiv-todo@2.12.0",
    "npm:pi-lean-ctx"
  ],
  "subagents": {
    "defaultModel": "MiniMax-M2.7",
    "agentOverrides": {
      "reviewer": {
        "model": "MiniMax-M2.7"
      },
      "scout": {
        "tools": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor", "todo"],
        "subagentOnlyExtensions": [
          "/home/hd2admin/.pi/agent/npm/node_modules/@juicesharp/rpiv-todo/index.ts"
        ]
      }
    }
  },
  "tuiMode": "regular",
  "pi-codex-fast": {
    "mode": "fast",
    "enabled": true
  },
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "openai-codex/gpt-6-luna": {
        "reserveTokens": 550000
      },
      "openai-codex/gpt-6.1-sol": {
        "reserveTokens": 122400
      },
      "minimax/MiniMax-M3": {
        "reserveTokens": 500000
      }
    }
  },
  "enabledModels": [
    "openai-codex/gpt-6-luna",
    "zai/glm-5.3-flash",
    "openai-codex/gpt-6.1-sol",
    "minimax/MiniMax-M3",
    "minimax/MiniMax-M2.7-highspeed",
    "minimax/MiniMax-M2.7",
    "openai-codex/gpt-6-astra",
    "zai/glm-4.7",
    "zai/glm-5-turbo",
    "zai/glm-5.2",
    "zai/glm-5.2-highspeed",
    "zai/glm-5.3",
    "zai/glm-5.3-highspeed"
  ],
  "defaultProjectTrust": "always"
}
